{
  "name": "Portafolio · Contacto",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contacto",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "https://cristophergs.github.io,http://localhost:3000" }
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "portafolio-contacto"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "leftValue": "={{ $json.body.correo }}", "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$", "operator": { "type": "string", "operation": "regex" } },
            { "leftValue": "={{ $json.body.mensaje }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } },
            { "leftValue": "={{ $json.body.empresa }}", "rightValue": "", "operator": { "type": "string", "operation": "empty", "singleValue": true } }
          ]
        }
      },
      "name": "Validar",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "url", "value": "PEGA_AQUI_LA_URL_DE_TU_GOOGLE_SHEET" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Contactos" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $now.toISO() }}",
            "nombre": "={{ $json.body.nombre }}",
            "correo": "={{ $json.body.correo }}",
            "tipo": "={{ $json.body.tipo }}",
            "presupuesto": "={{ $json.body.presupuesto }}",
            "mensaje": "={{ $json.body.mensaje }}",
            "estado": "nuevo"
          }
        }
      },
      "name": "Guardar en CRM",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [440, 200]
    },
    {
      "parameters": {
        "chatId": "PEGA_AQUI_TU_CHAT_ID_DE_TELEGRAM",
        "text": "=🚀 Nuevo contacto desde el portafolio\n\n👤 {{ $('Webhook').item.json.body.nombre }}\n✉️ {{ $('Webhook').item.json.body.correo }}\n🧩 {{ $('Webhook').item.json.body.tipo }}\n💰 {{ $('Webhook').item.json.body.presupuesto || 'sin definir' }}\n\n{{ $('Webhook').item.json.body.mensaje }}",
        "additionalFields": {}
      },
      "name": "Avisar a Cristopher",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Webhook').item.json.body.correo }}",
        "subject": "=Recibí tu mensaje, {{ $('Webhook').item.json.body.nombre }}",
        "emailType": "text",
        "message": "=Hola {{ $('Webhook').item.json.body.nombre }},\n\nGracias por escribirme. Recibí tu mensaje sobre \"{{ $('Webhook').item.json.body.tipo }}\" y te respondo personalmente muy pronto.\n\nSi quieres adelantar, agenda una llamada corta aquí: PEGA_AQUI_TU_ENLACE_DE_CAL_COM\n\nCristopher Guerra\nDesarrollador fullstack\nhttps://cristophergs.github.io/portafolio-2021/\n\n—\nEste correo lo envió una automatización con n8n, como las que puedo construir para tu negocio.",
        "options": { "appendAttribution": false }
      },
      "name": "Correo de confirmación",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [880, 200]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={ \"ok\": true }", "options": { "responseCode": 200 } },
      "name": "200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 200]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={ \"ok\": false, \"error\": \"datos inválidos\" }", "options": { "responseCode": 422 } },
      "name": "422 Datos inválidos",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 420]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Validar", "type": "main", "index": 0 }]] },
    "Validar": { "main": [[{ "node": "Guardar en CRM", "type": "main", "index": 0 }], [{ "node": "422 Datos inválidos", "type": "main", "index": 0 }]] },
    "Guardar en CRM": { "main": [[{ "node": "Avisar a Cristopher", "type": "main", "index": 0 }]] },
    "Avisar a Cristopher": { "main": [[{ "node": "Correo de confirmación", "type": "main", "index": 0 }]] },
    "Correo de confirmación": { "main": [[{ "node": "200 OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
